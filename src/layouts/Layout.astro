---
interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    image?: string;
}

const { 
    title = "Hodowla Little Angels – Shih Tzu ZHPR / UCI | Ograszka", 
    description = "Hodowla Little Angels – profesjonalna i domowa hodowla psów rasy Shih Tzu. Szczenięta z rodowodem ZHPR / UCI, zdrowe i zsocjalizowane. Sprawdź dostępne mioty. Ograszka, Polska.",
    canonical,
    image = "https://littleangelsshihtzu.pl/assets/images/logos/logo_black.png"
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, "https://littleangelsshihtzu.pl").href;
---
<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="hodowla little angels, Shih Tzu, hodowla Shih Tzu, szczeniaki Shih Tzu, little angels shih tzu, ZHPR, UCI, hodowla psów rasowych, Ograszka, szczenięta shih tzu, shih tzu hodowla polska">
    <meta name="author" content="Hodowla Little Angels">
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">

    <!-- Geo / Local SEO -->
    <meta name="geo.region" content="PL">
    <meta name="geo.placename" content="Ograszka, Polska">
    <meta name="language" content="pl">

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pl" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={image}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="pl_PL">
    <meta property="og:site_name" content="Hodowla Little Angels">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={image}>

    <!-- Favicon -->
    <link rel="shortcut icon" href="/assets/images/logos/favicon.jpg" type="image/x-icon">

    <!-- DNS Prefetch & Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
    <link rel="dns-prefetch" href="https://kit.fontawesome.com">
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">

    <!-- CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <link rel="stylesheet" href="/styles/global.css">
</head>

<body>

    <!-- Navigation -->
    <header class="main-header">
        <div class="container header-content">
            <a href="/" class="logo">
                <span class="logo-text">Little Angels</span>
            </a>

            <nav class="main-nav">
                <ul class="nav-list">
                    <li><a href="/#hero">Home</a></li>
                    <li><a href="/#about">O Hodowli</a></li>
                    <li><a href="/#breed">O Rasie</a></li>
                    <li><a href="/litters">Nasze Mioty</a></li>
                    <li><a href="/#contact">Kontakt</a></li>
                </ul>
            </nav>

            <div class="social-icons-header">
                <a href="https://www.facebook.com/hodowlalittleangels" aria-label="Facebook" target="_blank"><i
                        class="fa-brands fa-facebook"></i></a>
                <a href="https://www.instagram.com/hodowla_little_angels/" aria-label="Instagram" target="_blank"><i
                        class="fa-brands fa-instagram"></i></a>
                <a href="https://www.tiktok.com/@hodowlalittleangels" aria-label="Tiktok" target="_blank"><i
                        class="fa-brands fa-tiktok"></i></a>
            </div>

            <button class="mobile-menu-btn" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <slot />

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-content">
                <!-- Brand Column -->
                <div class="footer-col footer-brand">
                    <span class="footer-logo-text">Little Angels</span>
                    <p>Profesjonalna hodowla Shih Tzu z pasją i miłością. Nasze psy to nasza rodzina.</p>
                    <div class="footer-logo-image">
                        <img src="/assets/images/logos/logo_white.png" alt="Little Angels Logo białe" loading="lazy">
                    </div>
                </div>

                <!-- Navigation Column -->
                <div class="footer-col footer-links">
                    <h3>Nawigacja</h3>
                    <ul>
                        <li><a href="/#hero">Strona Główna</a></li>
                        <li><a href="/#about">O Hodowli</a></li>
                        <li><a href="/#breed">O Rasie</a></li>
                        <li><a href="/litters">Mioty</a></li>
                        <li><a href="/#contact">Kontakt</a></li>
                    </ul>
                </div>

                <!-- Contact Column -->
                <div class="footer-col footer-contact">
                    <h3>Kontakt</h3>
                    <ul>
                        <li>
                            <i class="fa-solid fa-phone"></i>
                            <span>+48 791 619 015</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-envelope"></i>
                            <span>hodowla.littleangels@gmail.com</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Ograszka 43B, Polska</span>
                        </li>
                    </ul>
                </div>

                <!-- Socials Column -->
                <div class="footer-col footer-socials">
                    <h3>Śledź nas</h3>
                    <div class="social-icons-footer">
                        <a href="https://www.facebook.com/hodowlalittleangels" aria-label="Facebook" target="_blank">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="https://www.instagram.com/hodowla_little_angels/" aria-label="Instagram"
                            target="_blank">
                            <i class="fa-brands fa-instagram"></i>
                        </a>
                        <a href="https://www.tiktok.com/@hodowlalittleangels" aria-label="Tiktok" target="_blank">
                            <i class="fa-brands fa-tiktok"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 Little Angels. Wszelkie prawa zastrzeżone. | Projekt: <a href="https://bartoszkutnik.pl/"
                        id="footer-author" target="_blank">Bartosz Kutnik</a> | <a href="/polityka-prywatnosci"
                        style="color: inherit; text-decoration: none;">Polityka Prywatności</a></p>
            </div>
        </div>
    </footer>

    <button id="back-to-top" class="back-to-top" aria-label="Wróć do góry">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <script is:inline src="https://kit.fontawesome.com/70f2470b08.js" crossorigin="anonymous"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script is:inline src="/scripts/main.js"></script>
</body>

</html>
