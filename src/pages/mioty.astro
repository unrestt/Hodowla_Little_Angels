---
import Layout from '../layouts/Layout.astro';
import mioty from '../data/mioty.json';

const currentLitter = mioty.find(m => m.current);
const historyLitters = mioty
    .filter(m => !m.current)
    .sort((a, b) => b.nazwa_miotu.localeCompare(a.nazwa_miotu));

const formatDate = (dateString: string) => {
    if (!dateString) return "";
    const [year, month, day] = dateString.split('-');
    return `${day}.${month}.${year}`;
};
---
<Layout title="Nasze Mioty | Hodowla Little Angels" description="Aktualne i historyczne mioty rasy Shih Tzu w hodowli Little Angels. Szczenięta z rodowodem ZHPR / UCI.">
    <!-- Page Hero -->
    <section class="page-hero pages-hero-litters">
        <div class="container">
            <h1 class="page-title">Nasze Mioty</h1>
        </div>
    </section>

    <!-- Current Litter Section -->
    <section class="litters-content" style="padding: 4rem 0;">
        <div class="container">
            <div id="current-litter-section" class="litter-section">
                <h2 class="section-title">Aktualne Szczenięta</h2>
                
                {currentLitter ? (
                    <div id="current-litter-container">
                        <div class="current-litter-display">
                            <div class="current-litter-image">
                                <a href={`/assets/images/mioty_images/${currentLitter.img}`} class="glightbox" data-gallery="current-litter-gallery">
                                    <img src={`/assets/images/mioty_images/${currentLitter.img}`} alt={currentLitter.nazwa_miotu} />
                                </a>
                            </div>
                            <div class="current-litter-info">
                                <h3>{currentLitter.nazwa_miotu}</h3>
                                <p class="current-litter-date"><i class="fa-regular fa-calendar"></i> Urodzone: {formatDate(currentLitter.data_urodzenia)}</p>
                                
                                <div class="current-puppies-section">
                                    <h4>Szczenięta w tym miocie:</h4>
                                    <div class="current-puppies-list">
                                        {currentLitter.szczenieta && currentLitter.szczenieta.map(puppy => (
                                            <div class={`current-puppy-tag ${puppy.reserved ? 'is-reserved' : 'is-available'}`}>
                                                {puppy.plec === 'samiec' || puppy.plec === 'M' ? (
                                                    <i class="fa-solid fa-mars u-male"></i>
                                                ) : (
                                                    <i class="fa-solid fa-venus u-female"></i>
                                                )}
                                                {' '}{puppy.imie}{' '}
                                                {puppy.reserved ? (
                                                    <i class="fa-solid fa-ban status-icon reserved" title="Zarezerwowany"></i>
                                                ) : (
                                                    <i class="fa-regular fa-circle-check status-icon available" title="Dostępny"></i>
                                                )}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                                <p style="margin-top: 15px; font-size: 0.95rem; color: #666; font-style: italic;">
                                    Więcej zdjęć i filmów szczeniąt znajdziesz na naszych profilach.
                                </p>
                                <a href="/#kontakt" class="contact-btn-litter" style="margin-top: 20px;">Zapytaj o szczeniaka</a>
                            </div>
                        </div>
                    </div>
                ) : (
                    <div class="no-litters-message">
                        <i class="fa-solid fa-paw" style="font-size: 3rem; margin-bottom: 1.2rem; display: block;"></i>
                        <p>Obecnie nie posiadamy dostępnych szczeniąt. Zapraszamy do śledzenia naszych mediów społecznościowych.</p>
                        <a href="/#kontakt" class="btn btn-hero" style="margin-top: 35px;">Zapisz się na listę oczekujących</a>
                    </div>
                )}
            </div>
        </div>
    </section>

    <!-- History Litters -->
    <section class="litters-history">
        <div class="container">
            <h2 class="section-title">Poprzednie Mioty</h2>
            <div id="litters-container" class="litters-grid">
                {historyLitters.map(litter => (
                    <article class="litter-card">
                        <div class="litter-image">
                            <img src={`/assets/images/mioty_images/${litter.img}`} alt={litter.nazwa_miotu} loading="lazy" />
                        </div>
                        <div class="litter-details">
                            <div>
                                <h3 class="litter-title">{litter.nazwa_miotu}</h3>
                                <span class="litter-date">Data urodzenia: {formatDate(litter.data_urodzenia)}</span>
                            </div>
                            <button class="litter-btn" onclick={`window.openLitterModal(${JSON.stringify(litter)})`}>Zobacz więcej</button>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <!-- Modal for puppies -->
    <div id="litter-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="modal-header">
                <h2 id="modal-title">Nazwa Miotu</h2>
                <p id="modal-date">Data urodzenia: DD.MM.YYYY</p>
            </div>
            <div class="modal-body">
                <div class="modal-image-container">
                    <a id="modal-image-link" href="#" class="glightbox" data-gallery="litter-gallery">
                        <img id="modal-image" src="" alt="Zdjęcie miotu">
                    </a>
                </div>
                <div class="modal-puppies">
                    <h3>Szczenięta</h3>
                    <ul id="modal-puppies-list" class="puppies-list">
                    </ul>
                </div>
            </div>
        </div>
    </div>
</Layout>
