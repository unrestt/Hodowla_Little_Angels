---
import Layout from '../layouts/Layout.astro';
---

    <!-- Schema.org JSON-LD Structured Data for Rich Snippets -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["LocalBusiness", "AnimalShelter"],
          "@id": "https://littleangelsshihtzu.pl/#organization",
          "name": "Hodowla Little Angels",
          "alternateName": "Little Angels Shih Tzu",
          "description": "Profesjonalna i domowa hodowla psów rasy Shih Tzu z rodowodem ZHPR / UCI. Zdrowe, zsocjalizowane szczenięta z pasją i miłością.",
          "url": "https://littleangelsshihtzu.pl/",
          "logo": "https://littleangelsshihtzu.pl/assets/images/logos/logo_black.png",
          "image": "https://littleangelsshihtzu.pl/assets/images/logos/logo_black.png",
          "telephone": "+48791619015",
          "email": "hodowla.littleangels@gmail.com",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Ograszka 43B",
            "addressLocality": "Ograszka",
            "addressCountry": "PL"
          },
          "sameAs": [
            "https://www.facebook.com/hodowlalittleangels",
            "https://www.instagram.com/hodowla_little_angels/",
            "https://www.tiktok.com/@hodowlalittleangels"
          ],
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
            ],
            "opens": "09:00",
            "closes": "20:00"
          },
          "priceRange": "$",
          "keywords": "hodowla little angels, Shih Tzu, szczeniaki Shih Tzu, hodowla psów rasowych, ZHPR, UCI"
        },
        {
          "@type": "WebSite",
          "@id": "https://littleangelsshihtzu.pl/#website",
          "url": "https://littleangelsshihtzu.pl/",
          "name": "Hodowla Little Angels",
          "description": "Oficjalna strona hodowli psów rasy Shih Tzu – Little Angels",
          "inLanguage": "pl",
          "publisher": {
            "@id": "https://littleangelsshihtzu.pl/#organization"
          }
        },
        {
          "@type": "FAQPage",
          "@id": "https://littleangelsshihtzu.pl/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Czy szczenięta Shih Tzu posiadają rodowód?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Tak, wszystkie nasze szczenięta otrzymują rodowód ZHPR / UCI, która uprawnia do wyrobienia wielopokoleniowego rodowodu uznawanego na całym świecie."
              }
            },
            {
              "@type": "Question",
              "name": "Jak wygląda proces rezerwacji szczenięcia Shih Tzu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Aby zarezerwować szczenię, prosimy o kontakt telefoniczny. Po wstępnej rozmowie i decyzji pobieramy zadatek, który jest gwarancją rezerwacji wybranego maluszka."
              }
            },
            {
              "@type": "Question",
              "name": "W jakim wieku można odebrać szczenię Shih Tzu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Szczenięta są gotowe do odbioru po ukończeniu minimum 10 tygodni życia. W tym czasie są już po przeglądzie hodowlanym, szczepieniach i odrobaczeniu stosownym do wieku."
              }
            },
            {
              "@type": "Question",
              "name": "Czy możliwy jest transport szczenięcia za granicę?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Nie oferujemy bezpośredniego transportu psa za granicę, ale kompleksowo pomagamy w wyrobieniu wszelkich dokumentów wyjazdowych oraz paszportu."
              }
            },
            {
              "@type": "Question",
              "name": "Co zawiera wyprawka szczenięcia Shih Tzu?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Każdy szczeniak otrzymuje bogatą wyprawkę: legowisko, karmę, dokumenty, zabawki, kocyk z zapachem mamy oraz poradnik nowego nabywcy."
              }
            }
          ]
        }
      ]
    }
    </script>

<Layout title="Hodowla Little Angels – Shih Tzu ZHPR / UCI | Ograszka">


    <!-- Navigation -->
    

    <!-- Hero Section -->
    <section id="start" class="hero">
        <!-- Swiper -->
        <div class="swiper heroSwiper">
            <div class="swiper-wrapper">
                <div class="swiper-slide" style="background-image: url('/assets/images/hero/slide-1.png');">
                </div>
                <div class="swiper-slide" style="background-image: url('/assets/images/hero/slide-2.jpg');"></div>
                <div class="swiper-slide" style="background-image: url('/assets/images/hero/slide-3.jpg');"></div>
                <div class="swiper-slide" style="background-image: url('/assets/images/hero/slide-4.jpg');"></div>
            </div>
            <!-- Add Pagination -->
            <div class="swiper-pagination"></div>
            <!-- Add Navigation -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>
        </div>

        <div class="hero-overlay-content">
            <div class="container hero-container">
                <div class="hero-text fade-in">
                    <p class="hero-eyebrow">Hodowla psów rasowych Shih Tzu</p>
                    <h1>Little Angels</h1>
                    <div class="hero-divider"></div>
                    <p class="hero-subtitle">Shih Tzu z pasją i miłością</p>

                    <blockquote class="hero-quote">
                        „Kiedy patrzę w oczy zwierzęcia, nie widzę w nich zwierzęcia.<br>
                        Widzę przyjaciela. Czuję duszę."
                        <cite>– A.D. Williams</cite>
                    </blockquote>

                    <div class="hero-cta">
                        <a href="#kontakt" class="btn btn-hero">Skontaktuj się</a>
                        <a href="#o-hodowli" class="btn-hero-outline">Poznaj nas</a>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- About Section -->
    <section id="o-hodowli">
        <div class="container">
            <h2 class="section-title reveal">O Naszej Hodowli</h2>
            <span class="section-subtitle reveal">Pasja / Etyka / Miłość</span>
            <div class="about-content">
                <div class="left-about reveal">
                    <div class="about-text">
                        <p>Witaj w <strong>Little Angels</strong>, miejscu, gdzie miłość do rasy Shih Tzu łączy się z
                            profesjonalnym podejściem do hodowli. Naszą misją jest hodowanie zdrowych, doskonale
                            zsocjalizowanych psów, które staną się przede wszystkim
                            wspaniałymi towarzyszami życia.</p>
                        <p>Wszystkie nasze psy są pełnoprawnymi członkami rodziny. Dbamy o ich rozwój fizyczny i
                            psychiczny
                            od pierwszych dni życia. Stawiamy na etykę, transparentność i ciągłe pogłębianie wiedzy
                            kynologicznej.</p>
                    </div>
                    <div class="association-logo">
                        <img src="/assets/images/logos/uci.png" alt="Logo UCI - United Kennel Clubs International"
                            loading="lazy">
                        <img src="/assets/images/logos/zhpr.png" alt="Logo ZHPR - Związek Hodowców Psów Rasowych"
                            loading="lazy">
                    </div>
                </div>
                <div class="about-images">
                    <div class="about-img-box reveal">
                        <img src="/assets/images/logos/logo_black.png" alt="Logo Hodowli Little Angels" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== DLACZEGO MY ===== -->
    <section id="why-us" class="why-us-section">
        <div class="container">
            <h2 class="section-title reveal">Dlaczego My?</h2>
            <span class="section-subtitle reveal">To co nas wyróżnia</span>
            <div class="why-us-grid">
                <div class="why-card reveal">
                    <div class="why-icon"><i class="fas fa-heart"></i></div>
                    <h3>Pełne szczepienia</h3>
                    <p>Każdy szczeniak opuszcza hodownię po komplecie szczepień i odrobaczeniu, potwierdzonych w książeczce zdrowia.</p>
                </div>
                <div class="why-card reveal">
                    <div class="why-icon"><i class="fas fa-paw"></i></div>
                    <h3>Socjalizacja od 1. dnia</h3>
                    <p>Maluszki wychowujemy w domu, wśród codziennych dźwięków i ludzi — trafiają do Ciebie pewne siebie i otwarte.</p>
                </div>
                <div class="why-card reveal">
                    <div class="why-icon"><i class="fas fa-certificate"></i></div>
                    <h3>Rodowód ZHPR / UCI</h3>
                    <p>Wszystkie szczenięta otrzymują rodowód ZHPR UCI.</p>
                </div>
                <div class="why-card reveal">
                    <div class="why-icon"><i class="fas fa-comments"></i></div>
                    <h3>Wsparcie po zakupie</h3>
                    <p>Jesteśmy dostępni zawsze. Doradzamy w kwestiach pielęgnacji, diety i wychowania przez całe życie psa.</p>
                </div>
                <div class="why-card reveal">
                    <div class="why-icon"><i class="fas fa-home"></i></div>
                    <h3>Dom, nie hodowla</h3>
                    <p>Nasze psy żyją razem z nami. Każdy szczeniak otrzymuje miłość, uwagę i staranny indywidualny rozwój.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== LICZNIKI ===== -->
    <section id="stats" class="stats-section">
        <div class="container">
            <div class="stats-grid">
                <div class="stat-item reveal">
                    <span class="stat-number" data-target="18">0</span>
                    <span class="stat-plus">+</span>
                    <span class="stat-label">Miotów</span>
                </div>
                <div class="stat-item reveal">
                    <span class="stat-number" data-target="81">0</span>
                    <span class="stat-plus">+</span>
                    <span class="stat-label">Szczeniąt</span>
                </div>
                <div class="stat-item reveal">
                    <span class="stat-number" data-target="7">0</span>
                    <span class="stat-plus">+</span>
                    <span class="stat-label">Lat doświadczenia</span>
                </div>
                <div class="stat-item reveal">
                    <span class="stat-number" data-target="100">0</span>
                    <span class="stat-plus">%</span>
                    <span class="stat-label">Szczęśliwych rodzin</span>
                </div>
            </div>
        </div>
    </section>
    <!-- Breed Info Section -->
    <section id="o-rasie">
        <div class="container">
            <h2 class="section-title reveal">O Rasie Shih Tzu</h2>
            <span class="section-subtitle reveal">Charakter / Pielęgnacja / Standard</span>

            <div class="breed-cards">
                <div class="breed-card reveal">
                    <span class="breed-icon"><i class="fa-solid fa-heart"></i></span>
                    <h3>Charakter</h3>
                    <p>Shih Tzu to psy o niezwykle pogodnym usposobieniu. Są towarzyskie, czułe i mocno przywiązane do
                        opiekunów. Idealnie sprawdzają się jako psy do towarzystwa dla rodzin i osób starszych.</p>
                </div>
                <div class="breed-card reveal">
                    <span class="breed-icon"><i class="fa-solid fa-scissors"></i></span>
                    <h3>Pielęgnacja</h3>
                    <p>Wymagają regularnej pielęgnacji, zwłaszcza jeśli mają długą, wystawową szatę. Codzienne czesanie
                        i regularne kąpiele to podstawa ich zdrowego wyglądu.</p>
                </div>
                <div class="breed-card reveal">
                    <span class="breed-icon"><i class="fa-solid fa-scale-balanced"></i></span>
                    <h3>Standard</h3>
                    <p>Pies mały, ale solidny. O dostojnym sposobie bycia i charakterystycznej "chryzantemowej" głowie.
                        Ruch płynny i elegancki, podkreślający ich arystokratyczne pochodzenie.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- History Timeline (Example) -->
    <section id="history">
        <div class="container">
            <h2 class="section-title reveal">Historia Rasy</h2>
            <span class="section-subtitle reveal">Od Cesarskich Pałaców do Naszych Domów</span>

            <div class="timeline reveal">
                <div class="timeline-item left">
                    <div class="timeline-content">
                        <h3>XVII wiek</h3>
                        <p>Początki rasy w Tybecie, gdzie psy te były czczone jako "Lwy Buddy".</p>
                    </div>
                </div>
                <div class="timeline-item right">
                    <div class="timeline-content">
                        <h3>Cesarstwo Chińskie</h3>
                        <p>Psy trafiają na dwór cesarski w Pekinie, gdzie stają się ulubieńcami cesarzy.</p>
                    </div>
                </div>
                <div class="timeline-item left">
                    <div class="timeline-content">
                        <h3>Lata 30. XX w.</h3>
                        <p>Rasa trafia do Europy, rozpoczynając swoją drogę do popularności na całym świecie.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="testimonials-section">
        <div class="container">
            <h2 class="section-title reveal">Opinie</h2>
            <span class="section-subtitle reveal">Zaufali nam i są szczęśliwi</span>

            <!-- Slider row: [◀] [swiper] [▶] -->
            <div class="testimonials-slider-row">
                <button class="testimonials-prev t-nav-btn" aria-label="Poprzednia opinia">
                    <i class="fa-solid fa-arrow-left"></i>
                </button>

                <div class="swiper testimonialsSwiper">
                    <div class="swiper-wrapper">
                        
                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„z całego serduszka polecamy hodowlę ❤️ Massimo to piękny pies który wniósł trochę szaleństwa do naszego domu. Nauczony manier, kontaktowy, odważny, nauczony czystości. Jesteśmy wdzięczni za pracę i serce włożoną w wychowanie."</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Monika</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Polecam hodowle Little Angels! Wspaniały hodowca, mamy cudownego chłopca z hodowli.❤️Pieski są bardzo zadbane żyją w warunkach domowych otoczone miłością  rodziny, przyzwyczajone do dzieci 🫶
Hodowla prowadzona z miłość do rasy, stały kontakt z hodowcą to coś cudownego na każde pytanie i problem znajdzie idealne rozwiązanie 😇"</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Wiktoria</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Mamy małego Aniołka❤️ Najlepsza dbałość o najmniejsze drobiazgi- dopieszczone maluszki, stały kontakt i wsparcie (nawet po zakupie)! Wspaniała praca z maluchami- widać efekty, kiedy nasze maleństwo do nas trafiło. Moim marzeniem było trafić na taką profesjonalną hodowlę i szczęście mi dopisało! Dziękujemy raz jeszcze."</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Patka</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Super kontakt z hodowlą. Pieski dużo nauczone i bardzo zadbane. Bardzo jesteśmy zadowoleni."</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Katarzyna</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Polecam zdecydowanie. Zawsze można liczyć na pomoc i radę. Szczeniaczki są socjalizowane co widać przy odbiorze – nie trzeba pod tym względem z nimi pracować, nauczone są załatwiania się na matę, co naprawdę się przydaje. Polecam!"</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Marzena</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Z całego serca polecam Panią Anetę i jej hodowlę. Cały proces od urodzin pieska wspaniale poprowadzony. Regularne wiadomości i zdjęcia. Widać od razu, że pieski są otoczone największą miłością i opieką. Przepiękne i co najważniejsze zdrowe! Pani Aneta zawsze służy pomocą. Jeszcze raz dziękujemy za naszą Daisy."</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Kinga</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Bardzo polecam hodowlę, pieski dobrze wychowane, dobrze ułożone, grzeczne, spokojne. Szczeniaczek „wiedział" do czego służy mata. Kontakt z hodowlą super, Pani bardzo pomocna, chętnie udzielająca odpowiedzi na pytania dotyczące np. kosmetyków czy karmy. Bardzo polecam!"</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Krzysztof</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Świetny kontakt z Little Angels od samego początku – zdjęcia, filmiki z opieki nad szczeniakiem w okresie jego dorastania u Hodowcy. Zawsze odpowiedź na każde pytanie i przydatna porada na temat pielęgnacji, żywienia itp. – i tak do dnia dzisiejszego. Polecam w 100% w imieniu swoim i Newtona (Dastiego)."</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Mariusz</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="swiper-slide">
                            <div class="testimonial-card">
                                <i class="fa-solid fa-quote-left testimonial-quote-icon"></i>
                                <p class="testimonial-text">„Bardzo polecam! Profesjonalna opieka nad szczeniakiem!"</p>
                                <div class="testimonial-author">
                                    <div class="author-info">
                                        <h4>Klaudia</h4>
                                        <div class="testimonial-stars"><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    
                    <div class="swiper-pagination testimonials-pagination"></div>
                </div>

                <button class="testimonials-next t-nav-btn" aria-label="Następna opinia">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Zostaw opinię CTA -->
            <div class="review-cta reveal">
                <p class="review-cta-text">Byłeś naszym klientem? Podziel się swoją opinią! 🐾</p>
                <div class="review-cta-buttons">
